# ------------------------------------------------------------
# Keep repository structure (re-include placeholders)
# ------------------------------------------------------------

!.gitkeep
!logs/.gitkeep
!data/.gitkeep
!data/models/.gitkeep
!data/cache/.gitkeep
!config/.gitkeep

# Generated benchmark page (./golem report); the data is bench/results.jsonl
bench/report.html

# Auto-tune output (per machine; the winning flags, regenerated by ./golem tune)
data/tuned/

# Local Rust dev toolchain (scripts/setup-rust-toolchain.sh). The config holds
# this machine's toolchain path; CI builds MSVC and never reads it.
/.cargo/config.toml
golem-rs/.cargo/config.toml

# The dev binary scripts/cargo.sh drops at the root so it runs on the
# checkout's own bench/, data/ and logs/ (a release has the same shape).
/golem.exe
/golem-bin

# The binary owns this file now: it is created from golem.toml.example on
# first run and holds the machine own values, so it stays out of the tree the
# way .env and .local/ do.
golem.toml
