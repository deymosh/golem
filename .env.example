# ============================================================
# Golem - configuration
# ============================================================
#
# Copy this file to .env and adjust. The ./golem control script and
# every script in scripts/ source it automatically, and compose.yml
# reads it via --env-file.
#
# The whole stack is meant to be agnostic:
#   - swap the MODEL by changing HF_REPO / MODEL_FILE
#   - swap the BACKEND by changing LOCAL_AI_BASE_URL + MODEL_ALIAS
# See docs/ for details.
# ============================================================


# ------------------------------------------------------------
# Deployment
# ------------------------------------------------------------

# How `./golem up` runs the stack:
#   docker  - llama.cpp in a container (default, any OS)
#   native  - host-built llama.cpp (Linux)
#   windows - official llama-server.exe straight on Windows, no Docker/WSL;
#             ~+50% decode over docker on Windows hosts, recommended there
#             (see docs/windows-native.md)
# Override per-invocation with `./golem up --docker` / `--native` / `--windows`.
DEPLOY_MODE="docker"

# GPU vendor. auto (default when unset) detects it — NVIDIA -> cuda,
# AMD -> rocm — so most machines need nothing here. Set it explicitly when
# detection can't work or guesses wrong (headless box, remote host, dual
# GPU). Affects the docker image (compose profile), the Windows llama.cpp
# release asset and the native build flags. AMD details: docs/amd-rocm.md.
#GPU_BACKEND="auto"

# windows mode only: inference engine, one of engines/<name>/ (llama.cpp,
# ik_llama.cpp, strata). Each engine.ini pins a release that the start script
# installs into .local/engines/<name>/; ENGINE_BUILD overrides the pin
# ("latest" follows upstream, ungated). Only llama.cpp is eval-gated and
# serves /v1/messages + router mode; ik_llama.cpp is experimental, OpenAI
# API only, and serves just the MODEL_ALIAS preset. strata (experimental)
# installs itself with its own setup and serves its own Qwen3.6 UD-Q4_K_XL
# (model name "qwen3.6-35b-a3b-ud-q4_k_xl"), not the presets.
#ENGINE="llama.cpp"


# ------------------------------------------------------------
# Inference server (OpenAI AND Anthropic compatible, layer 2)
# ------------------------------------------------------------

# Where the local inference server listens. 0.0.0.0 = reachable from
# the LAN (needed when clients run on other machines).
LOCAL_AI_HOST="127.0.0.1"
LOCAL_AI_PORT="8000"

# Shared secret for the inference server itself (llama-server --api-key).
# OpenAI clients send it as a Bearer token; Anthropic clients as
# ANTHROPIC_AUTH_TOKEN / x-api-key.
LOCAL_AI_API_KEY="local-ai-key"

# Base URL of the OpenAI-compatible API. Scripts derive it from
# HOST/PORT by default; override it to point at another backend
# (Ollama :11434/v1, vLLM :8000/v1, LM Studio :1234/v1, ...).
# See docs/backends.md.
LOCAL_AI_BASE_URL="http://127.0.0.1:8000/v1"


# ------------------------------------------------------------
# Model
# ------------------------------------------------------------

# Hugging Face repo and GGUF filename used by scripts/download-model.sh.
# Default: Qwen3.6-35B-A3B (MoE 35B total / 3B active, 256K ctx native) at
# Q4_K_M (~5 bits/weight) + MTP speculative decoding — measured best
# all-round on RTX 3060 12GB + 32GB RAM (native Windows: ~63 t/s decode,
# ~820 t/s prefill; same decode as the Q3 quants with better weights).
# See docs/models.md for the comparison tables, the Qwen3.8-27B profile
# and the alternatives.
HF_REPO="unsloth/Qwen3.6-35B-A3B-GGUF"
MODEL_FILE="Qwen3.6-35B-A3B-UD-Q4_K_M.gguf"

# Speculative decoding. draft-mtp uses the model's Multi-Token Prediction
# head as a free draft model (~2x decode, identical output). DRAFT_FILE is
# a standalone MTP head (downloaded from DRAFT_HF_REPO by ./golem pull);
# leave it empty when MODEL_FILE embeds its MTP layers (Qwen3.8 GGUFs do).
# Set SPEC_TYPE="" to disable.
SPEC_TYPE="draft-mtp"
DRAFT_HF_REPO="bartowski/Qwen_Qwen3.6-35B-A3B-GGUF"
DRAFT_FILE="mtp-Qwen_Qwen3.6-35B-A3B-Q4_0.gguf"

# Faster-prefill alternative (same decode, ~35% faster long prompts,
# lower precision ~3.8 bits/weight):
# MODEL_FILE="Qwen3.6-35B-A3B-UD-Q3_K_M.gguf"
# Qwen3.8-27B (dense, newest, embedded MTP) — fits 12GB only at short ctx:
# HF_REPO="unsloth/Qwen3.8-27B-GGUF"
# MODEL_FILE="Qwen3.8-27B-UD-IQ3_XXS.gguf"
# DRAFT_FILE=""
# CONTEXT_SIZE="32768"
# EXTRA_ARGS="--n-cpu-ffn 8 --temp 0.6 --top-k 20 --min-p 0"
# Dense / small alternatives:
# HF_REPO="unsloth/gemma-4-12b-it-GGUF"
# MODEL_FILE="gemma-4-12b-it-IQ4_NL.gguf"
# HF_REPO="lmstudio-community/Qwen3.5-9B-GGUF"
# MODEL_FILE="Qwen3.5-9B-Q4_K_M.gguf"

# Stable name the server advertises in /v1/models and /v1/messages.
# Keep this constant when you change MODEL_FILE so clients never need
# editing. See docs/models.md. In router mode (MODELS_PRESET) set it to the
# preset section clients should use by default, e.g. "ornith-1.5-35b".
MODEL_ALIAS="local-model"

# Router mode: serve several models from one llama-server, each loaded on
# its first request and swapped out when another is asked for (one at a
# time). Models and their per-model flags live in the preset file; the
# request's "model" field picks the section. When set, MODEL_FILE,
# DRAFT_FILE, SPEC_TYPE, CONTEXT_SIZE, GPU_LAYERS, CACHE_TYPE_*, LOAD_MODE
# and EXTRA_ARGS are not used for serving. Path is relative to the repo.
#MODELS_PRESET="config/models.ini"

# Unload the model (VRAM, RAM and KV cache) after this many seconds without
# requests; the next request reloads it (~25-30 s for the 22 GB default,
# a few seconds for a 9B once its file is in the OS cache). Frees the PC for other work between sessions. Empty =
# stay loaded. GET /health and /models don't count as activity, but in
# router mode GET /props?model=... does.
#SLEEP_IDLE_SECONDS="900"

# Optional Hugging Face token for gated/private repos.
# HF_TOKEN=""


# ------------------------------------------------------------
# Runtime (llama.cpp)
# ------------------------------------------------------------

# PARALLEL must stay at 1 for single-agent use: llama-server splits
# --ctx-size across slots, so PARALLEL=4 on a 262144 ctx yields four
# 64K slots, not one 256K conversation.
#
# Context: 236544 (231K) = Claude Code's 200K window + ~15% slack (the
# server tokenizes differently from Claude, and the last turn plus output
# must fit before auto-compact kicks in). The model's native ceiling is
# 262144; more than 231K only wastes VRAM here. Dense models are
# VRAM-limited instead: a 9B Q4 caps near ~100K (KV q8_0 ~75 KB/token).
CONTEXT_SIZE="236544"
# CPU threads: expert FFNs offloaded to RAM run here. On a 12700KF
# (8P+4E, 20 threads) 16 beat 20 by ~8% and 8 (P-cores only) by ~5%.
# Worth a sweep on other CPUs (./golem bench).
CPU_THREADS="16"
PARALLEL="1"

# GPU layers to offload. 99 = every layer on the GPU.
GPU_LAYERS="99"

# KV cache quantization. q8_0 (default) balances quality and VRAM;
# q4_0 trades a bit of recall for roughly half the KV footprint.
#CACHE_TYPE_K="q8_0"
#CACHE_TYPE_V="q8_0"

# Model load mode. mlock reads the whole model into locked RAM at start
# (best for 24/7 serving over a Windows bind mount); auto = mmap.
# This llama.cpp build replaced the old --no-mmap flag.
LOAD_MODE="mlock"

# Extra llama-server flags appended by compose (see entrypoint sh -c).
# MoE models: --cpu-moe puts ALL expert weights in system RAM (needs
# headroom in the WSL2 VM — set memory=24GB in %USERPROFILE%\.wslconfig
# on a 32GB host). --n-cpu-moe N keeps only the first N layers' experts
# in RAM and the rest on the GPU; raise N if VRAM is short, --cpu-moe is
# the floor. -b/-ub 2048 (default 512) is the big prefill lever for
# offloaded MoE: each ubatch streams the RAM experts over PCIe once, so
# 4x larger ubatches cut that traffic 4x — 340 -> 820 t/s prompt
# processing, same decode. n36 + ub2048 keeps ~0.7GB VRAM headroom on a
# 12GB card: at >~11.8GB the Windows driver silently spills to shared
# system memory and prefill collapses (n34/n33 + ub2048, ub4096 all hit
# it). Dense models that barely overflow VRAM: --n-cpu-ffn N.
# --temp/--top-k/--min-p are Qwen's coding defaults, used whenever the
# client doesn't send its own.
EXTRA_ARGS="--n-cpu-moe 36 -b 2048 -ub 2048 --temp 0.6 --top-k 20 --min-p 0"


# ------------------------------------------------------------
# Moved to golem.toml
# ------------------------------------------------------------
#
# The generation defaults (`TEMPERATURE`, `TOP_P`) and the tuner's knobs
# (`TUNE_MIN_DECODE`, `TUNE_MIN_PREFILL`, `TUNE_MIN_DEPTH_DECODE`,
# `TUNE_CTX_POLICY`, `TUNE_RUNS`, `TUNE_PREFILL`, `GATE_TOKENS`) are in
# `golem.toml` now, with the comments that used to be here. The `golem` binary
# is their only reader, and the shell drivers never source that file - so they
# left this one rather than living in two places, which is the failure that
# split exists to avoid. A key moves back here only if a shell driver starts
# reading it again.
