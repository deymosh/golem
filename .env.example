# ============================================================
# Golem - configuration
# ============================================================
#
# Copy this file to .env and adjust. The ./golem control script and
# every script in scripts/ source it automatically, and compose.yml
# reads it via --env-file.
#
# The whole stack is meant to be agnostic:
#   - swap the MODEL by changing HF_REPO / MODEL_FILE
#   - swap the BACKEND by changing LOCAL_AI_BASE_URL + MODEL_ALIAS
# See docs/ for details.
# ============================================================


# ------------------------------------------------------------
# Deployment
# ------------------------------------------------------------

# How `./golem up` runs the stack: docker (default; inference + SearXNG + MCP
# search) or native (host-built llama.cpp, no MCP services).
# Override per-invocation with `./golem up --docker` / `--native`.
DEPLOY_MODE="docker"


# ------------------------------------------------------------
# Inference server (OpenAI AND Anthropic compatible, layer 2)
# ------------------------------------------------------------

# Where the local inference server listens. 0.0.0.0 = reachable from
# the LAN (needed when clients run on other machines).
LOCAL_AI_HOST="127.0.0.1"
LOCAL_AI_PORT="8000"

# Shared secret for the inference server itself (llama-server --api-key).
# OpenAI clients send it as a Bearer token; Anthropic clients as
# ANTHROPIC_AUTH_TOKEN / x-api-key.
LOCAL_AI_API_KEY="local-ai-key"

# Base URL of the OpenAI-compatible API. Scripts derive it from
# HOST/PORT by default; override it to point at another backend
# (Ollama :11434/v1, vLLM :8000/v1, LM Studio :1234/v1, ...).
# See docs/backends.md.
LOCAL_AI_BASE_URL="http://127.0.0.1:8000/v1"


# ------------------------------------------------------------
# Model
# ------------------------------------------------------------

# Hugging Face repo and GGUF filename used by scripts/download-model.sh.
# Default: Qwen3.6-35B-A3B (MoE 35B total / 3B active, 256K ctx native) —
# measured best all-round on RTX 3060 12GB + 32GB RAM. See docs/models.md
# for the comparison table and the dense alternatives.
HF_REPO="unsloth/Qwen3.6-35B-A3B-GGUF"
MODEL_FILE="Qwen3.6-35B-A3B-UD-Q3_K_M.gguf"
# Dense / small alternatives:
# HF_REPO="unsloth/gemma-4-12b-it-GGUF"
# MODEL_FILE="gemma-4-12b-it-IQ4_NL.gguf"
# HF_REPO="lmstudio-community/Qwen3.5-9B-GGUF"
# MODEL_FILE="Qwen3.5-9B-Q4_K_M.gguf"

# Stable name the server advertises in /v1/models and /v1/messages.
# Keep this constant when you change MODEL_FILE so clients never need
# editing. See docs/models.md.
MODEL_ALIAS="local-model"

# Optional Hugging Face token for gated/private repos.
# HF_TOKEN=""


# ------------------------------------------------------------
# Runtime (llama.cpp)
# ------------------------------------------------------------

# PARALLEL must stay at 1 for single-agent use: llama-server splits
# --ctx-size across slots, so PARALLEL=4 on a 262144 ctx yields four
# 64K slots, not one 256K conversation.
#
# Context ceiling for MoE models with --cpu-moe: the model's native
# window (262144 here, ~7.7GB VRAM resident). Dense models are
# VRAM-limited instead: a 9B Q4 caps near ~100K (KV q8_0 ~75 KB/token).
CONTEXT_SIZE="262144"
CPU_THREADS="20"
PARALLEL="1"

# GPU layers to offload. 99 = every layer on the GPU.
GPU_LAYERS="99"

# KV cache quantization. q8_0 (default) balances quality and VRAM;
# q4_0 trades a bit of recall for roughly half the KV footprint.
#CACHE_TYPE_K="q8_0"
#CACHE_TYPE_V="q8_0"

# Model load mode. mlock reads the whole model into locked RAM at start
# (best for 24/7 serving over a Windows bind mount); auto = mmap.
# This llama.cpp build replaced the old --no-mmap flag.
LOAD_MODE="mlock"

# Extra llama-server flags appended by compose (see entrypoint sh -c).
# MoE models: --cpu-moe puts ALL expert weights in system RAM (needs
# headroom in the WSL2 VM — set memory=24GB in %USERPROFILE%\.wslconfig
# on a 32GB host). Once it runs, trade up to --n-cpu-moe N to keep the
# experts of the last layers on the GPU for more speed. Leave empty for
# dense models.
EXTRA_ARGS="--cpu-moe"


# ------------------------------------------------------------
# Generation defaults (used by scripts/benchmark-ai.sh)
# ------------------------------------------------------------

TEMPERATURE="0.15"
TOP_P="0.95"


# ------------------------------------------------------------
# Web search (SearXNG + MCP, docker only)
# ------------------------------------------------------------

# mcp-searxng listens here (streamable HTTP at /mcp). Point any agent's
# MCP config at http://<host>:<port>/mcp with this bearer token.
MCP_SEARCH_HOST="0.0.0.0"
MCP_SEARCH_PORT="8811"
MCP_SEARCH_API_KEY="local-mcp-key"

# Host allowlist for the MCP server's DNS-rebinding guard. When connecting
# from other machines, add your host's LAN IP both as "<ip>:8811" and "<ip>".
# MCP_HTTP_ALLOWED_HOSTS="localhost:8811,127.0.0.1:8811,192.168.1.N:8811,localhost,127.0.0.1,192.168.1.N"
