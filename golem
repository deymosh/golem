#!/usr/bin/env bash
#
#   ▟█▙  Golem - local AI construct for Claude Code
#   ▜█▛  one control script for the whole stack: Docker, native or Windows
#
# Usage:
#   ./golem <command> [--native | --docker | --windows] [args...]
#
# Commands:
#   setup             Inspect the machine, install build deps, scaffold dirs
#   install           Build llama.cpp with CUDA          (native only)
#   pull              Download the model from Hugging Face
#   up                Start the stack
#   down              Stop the stack
#   restart           down + up
#   status            Health of inference (+ docker ps in docker mode)
#   logs              Follow the inference logs
#   bench [args...]   Speed benchmark: decode + prefill tok/s
#   eval [args...]    Quality gate: sanity, tool calls, needle (--long N)
#   claude [args...]  Launch Claude Code pointed at the local model
#   env               Print the env exports for Claude Code
#   help              This message
#
# Mode:
#   DEPLOY_MODE in .env (docker|native|windows), overridden by
#   --docker / --native / --windows. windows = llama-server.exe run by
#   scripts/start-windows.ps1 (from Git Bash).

set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS="${ROOT_DIR}/scripts"
COMPOSE_FILE="${ROOT_DIR}/compose.yml"

# ------------------------------------------------------------
# .env
# ------------------------------------------------------------

if [[ ! -f "${ROOT_DIR}/.env" ]]; then
    if [[ -f "${ROOT_DIR}/.env.example" ]]; then
        # Zero-touch first run: the example defaults are sane, so keep
        # going with them; the user can tune .env any time after.
        cp "${ROOT_DIR}/.env.example" "${ROOT_DIR}/.env"
        echo "[INFO] Created .env from .env.example (defaults; edit any time)."
    else
        echo "[ERROR] No .env and no .env.example."
        exit 1
    fi
fi

set -a
# shellcheck disable=SC1091
source "${ROOT_DIR}/.env"
set +a

LOCAL_AI_HOST="${LOCAL_AI_HOST:-127.0.0.1}"
LOCAL_AI_PORT="${LOCAL_AI_PORT:-8000}"
LOCAL_AI_API_KEY="${LOCAL_AI_API_KEY:-local-ai-key}"
MODEL_ALIAS="${MODEL_ALIAS:-local-model}"
DEPLOY_MODE="${DEPLOY_MODE:-native}"

# ------------------------------------------------------------
# Args: pull out --native / --docker anywhere in the line
# ------------------------------------------------------------

CMD="${1:-help}"
shift || true

ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --native) DEPLOY_MODE="native" ;;
        --docker) DEPLOY_MODE="docker" ;;
        --windows) DEPLOY_MODE="windows" ;;
        *) ARGS+=("$1") ;;
    esac
    shift
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

die() { echo "[ERROR] $*" >&2; exit 1; }

have_compose() {
    command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1
}

dc() {
    have_compose || die "docker compose not available"
    docker compose -f "${COMPOSE_FILE}" --env-file "${ROOT_DIR}/.env" "$@"
}

winps() {
    # winps <script.ps1>: run a Windows-mode PowerShell script from Git Bash
    command -v powershell.exe >/dev/null 2>&1 || die "windows mode needs powershell.exe (run from Git Bash on Windows)"
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "${SCRIPTS}/$1")"
}

banner() {
    echo
    echo "  golem :: ${1}  (mode: ${DEPLOY_MODE})"
    echo "  --------------------------------------------"
}

# ------------------------------------------------------------
# Commands
# ------------------------------------------------------------

cmd_setup() {
    "${SCRIPTS}/setup-ai.sh"
}

cmd_install() {
    [[ "${DEPLOY_MODE}" == "docker" ]] && die "install is native-only; in docker mode use: ./golem up --docker (pulls the image)"
    [[ "${DEPLOY_MODE}" == "windows" ]] && die "windows mode installs the pinned llama.cpp build on first ./golem up"
    "${SCRIPTS}/install-llama-cpp.sh"
}

cmd_pull() {
    # The model lives on the host in either mode (mounted into the container).
    "${SCRIPTS}/download-model.sh"
}

# First run has to just work: whatever model files the active config
# references but data/models lacks get downloaded before anything starts.
# Windows mode does the same inside start-windows.ps1 (curl.exe), which
# also covers machines without Git Bash; here it's the same script on
# every other shell (Linux, macOS, WSL, Git Bash).
ensure_models() {
    if [[ "${DEPLOY_MODE}" == "windows" ]]; then
        return 0
    fi
    local models_dir="${ROOT_DIR}/data/models"
    if [[ -n "${MODELS_PRESET:-}" ]]; then
        # Router mode: the preset's "; Download: repo -> file" comments
        # say where each model comes from.
        local preset_path="${ROOT_DIR}/${MODELS_PRESET}"
        [[ -f "${preset_path}" ]] || return 0   # start script errors clearly
        sed -n 's/^[[:space:]]*;[[:space:]]*Download:[[:space:]]*\([^[:space:]]*\)[[:space:]]*->[[:space:]]*\([^[:space:]]*\).*/\1 \2/p' "${preset_path}" |
        while read -r repo file; do
            [[ -f "${models_dir}/${file}" ]] || "${SCRIPTS}/download-model.sh" "${repo}" "${file}"
        done
    else
        if [[ -z "${MODEL_FILE:-}" || ! -f "${models_dir}/${MODEL_FILE}" ]] \
           || [[ -n "${DRAFT_FILE:-}" && ! -f "${models_dir}/${DRAFT_FILE}" ]]; then
            cmd_pull
        fi
    fi
}

cmd_up() {
    banner "up"
    ensure_models
    if [[ "${DEPLOY_MODE}" == "docker" ]]; then
        dc up -d --remove-orphans
    elif [[ "${DEPLOY_MODE}" == "windows" ]]; then
        # prints its own (PowerShell-syntax) env block
        winps start-windows.ps1
        return
    else
        [[ -x "${ROOT_DIR}/.local/bin/llama-server" ]] || cmd_install
        "${SCRIPTS}/start-local-ai.sh"
    fi
    echo
    cmd_env
}

cmd_down() {
    banner "down"
    if [[ "${DEPLOY_MODE}" == "docker" ]]; then
        dc down
    elif [[ "${DEPLOY_MODE}" == "windows" ]]; then
        winps stop-windows.ps1
    else
        "${SCRIPTS}/stop-local-ai.sh" || true
    fi
}

cmd_restart() {
    cmd_down || true
    cmd_up
}

cmd_status() {
    banner "status"
    "${SCRIPTS}/health-check-ai.sh" || true
    if [[ "${DEPLOY_MODE}" == "docker" ]] && have_compose; then
        echo
        dc ps
    fi
}

cmd_logs() {
    if [[ "${DEPLOY_MODE}" == "docker" ]]; then
        dc logs -f
    elif [[ "${DEPLOY_MODE}" == "windows" ]]; then
        tail -f "${ROOT_DIR}/logs/llama-server-windows.log"
    else
        tail -f "${ROOT_DIR}/logs/local-ai.log"
    fi
}

cmd_bench() {
    "${SCRIPTS}/benchmark-ai.sh" "$@"
}

cmd_eval() {
    # The eval harness needs python3; Git Bash on Windows usually has none,
    # so hand it to WSL there (the script finds the Windows host itself).
    # A Windows python3 on Git Bash is not enough either: the script writes
    # request bodies to /tmp and pipes them to curl --data-binary, and MSYS
    # path conversion breaks that pair (needle/depth requests never send),
    # so on Git Bash always prefer WSL, where the script's Linux semantics hold.
    if [[ "${MSYSTEM:-}" != MINGW* ]] && command -v python3 >/dev/null 2>&1 && python3 -c 'pass' 2>/dev/null; then
        "${SCRIPTS}/eval-model.sh" "$@"
    elif command -v wsl.exe >/dev/null 2>&1; then
        wsl.exe --cd "$(cygpath -w "${ROOT_DIR}")" bash scripts/eval-model.sh "$@"
    else
        die "eval needs python3 (or WSL on Windows)"
    fi
}

cmd_env() {
    # llama-server speaks the Anthropic Messages API natively, so Claude
    # Code connects straight to it. 0.0.0.0 is a bind address, not a
    # destination: local clients use loopback.
    local host="${LOCAL_AI_HOST}"
    [[ "${host}" == "0.0.0.0" ]] && host="127.0.0.1"
    cat <<EOF
# Point Claude Code at Golem:
export ANTHROPIC_BASE_URL="http://${host}:${LOCAL_AI_PORT}"
export ANTHROPIC_AUTH_TOKEN="${LOCAL_AI_API_KEY}"
export ANTHROPIC_MODEL="${MODEL_ALIAS}"
export ANTHROPIC_SMALL_FAST_MODEL="${MODEL_ALIAS}"
EOF
}

cmd_claude() {
    command -v claude >/dev/null 2>&1 || die "claude (Claude Code) is not installed"
    exec env \
        ANTHROPIC_BASE_URL="http://127.0.0.1:${LOCAL_AI_PORT}" \
        ANTHROPIC_AUTH_TOKEN="${LOCAL_AI_API_KEY}" \
        ANTHROPIC_MODEL="${MODEL_ALIAS}" \
        ANTHROPIC_SMALL_FAST_MODEL="${MODEL_ALIAS}" \
        claude "$@"
}

cmd_help() {
    sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${CMD}" in
    setup)    cmd_setup ;;
    install)  cmd_install ;;
    pull)     cmd_pull ;;
    up)       cmd_up ;;
    down)     cmd_down ;;
    restart)  cmd_restart ;;
    status)   cmd_status ;;
    logs)     cmd_logs "${1:-}" ;;
    bench)    cmd_bench "$@" ;;
    eval)     cmd_eval "$@" ;;
    claude)   cmd_claude "$@" ;;
    env)      cmd_env ;;
    help|-h|--help) cmd_help ;;
    *) echo "[ERROR] unknown command: ${CMD}"; echo; cmd_help; exit 1 ;;
esac
